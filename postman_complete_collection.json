{
  "info": {
    "name": "Afiemo - Complete API Collection",
    "description": "Complete API collection including authentication, cart management, and checkout with Paystack integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data.token) {",
                  "        pm.environment.set(\"token\", jsonData.data.token);",
                  "        console.log(\"Token saved:\", jsonData.data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"phone_number\": \"+2348012345678\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            },
            "description": "Register a new user. Token will be auto-saved to environment variable."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data.token) {",
                  "        pm.environment.set(\"token\", jsonData.data.token);",
                  "        console.log(\"Token saved:\", jsonData.data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Login with email or username. Token will be auto-saved to environment variable."
          },
          "response": []
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/profile",
              "host": ["{{base_url}}"],
              "path": ["profile"]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cart",
              "host": ["{{base_url}}"],
              "path": ["cart"]
            }
          },
          "response": []
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/cart/add",
              "host": ["{{base_url}}"],
              "path": ["cart", "add"]
            }
          },
          "response": []
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/cart/items/1",
              "host": ["{{base_url}}"],
              "path": ["cart", "items", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cart/items/1",
              "host": ["{{base_url}}"],
              "path": ["cart", "items", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cart/clear",
              "host": ["{{base_url}}"],
              "path": ["cart", "clear"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        {
          "name": "Get Checkout Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/checkout/summary",
              "host": ["{{base_url}}"],
              "path": ["checkout", "summary"]
            }
          },
          "response": []
        },
        {
          "name": "Initialize Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shipping_address_id\": 1,\n  \"billing_address_id\": 1,\n  \"notes\": \"Please handle with care\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/checkout/initialize",
              "host": ["{{base_url}}"],
              "path": ["checkout", "initialize"]
            }
          },
          "response": []
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"ORD-123-1696694400\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/checkout/verify",
              "host": ["{{base_url}}"],
              "path": ["checkout", "verify"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Vendor",
      "item": [
        {
          "name": "Get Nigerian Banks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/vendor/banks",
              "host": ["{{base_url}}"],
              "path": ["vendor", "banks"]
            },
            "description": "Returns a list of Nigerian banks with their Paystack bank codes. Use this to get the correct bank_code before saving bank details."
          },
          "response": []
        },
        {
          "name": "Get Vendor Bank Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/vendor/bank-details",
              "host": ["{{base_url}}"],
              "path": ["vendor", "bank-details"]
            },
            "description": "Retrieve the authenticated vendor's saved bank account details."
          },
          "response": []
        },
        {
          "name": "Create / Update Vendor Bank Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bank_name\": \"GTBank\",\n  \"account_number\": \"0123456789\",\n  \"account_name\": \"John Doe\",\n  \"bank_code\": \"058\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/vendor/bank-details",
              "host": ["{{base_url}}"],
              "path": ["vendor", "bank-details"]
            },
            "description": "Create or update the authenticated vendor's bank account details. bank_code is optional but required for Paystack withdrawals. Use GET /vendor/banks to find the correct bank_code."
          },
          "response": []
        },
        {
          "name": "Resolve Account Number",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/vendor/resolve-account?account_number=0123456789&bank_code=058",
              "host": ["{{base_url}}"],
              "path": ["vendor", "resolve-account"],
              "query": [
                { "key": "account_number", "value": "0123456789", "description": "10-digit account number" },
                { "key": "bank_code", "value": "058", "description": "Bank code from GET /vendor/banks. Use 001 in test mode." }
              ]
            },
            "description": "Resolve an account number to its account name via Paystack. Call this as the vendor types their account number to auto-fill the account_name field. NOTE: In test mode, only bank_code=001 works reliably."
          },
          "response": []
        },
        {
          "name": "List My Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/vendor/products",
              "host": ["{{base_url}}"],
              "path": ["vendor", "products"]
            },
            "description": "List all products belonging to the authenticated vendor."
          },
          "response": []
        },
        {
          "name": "Create Product (with Images)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Product Name", "type": "text" },
                { "key": "short_description", "value": "Short description (max 500 chars)", "type": "text" },
                { "key": "description", "value": "Full product description", "type": "text" },
                { "key": "price", "value": "5000", "type": "text" },
                { "key": "quantity", "value": "10", "type": "text" },
                { "key": "category_id", "value": "1", "type": "text" },
                { "key": "status", "value": "active", "type": "text", "description": "active | inactive | draft" },
                { "key": "sku", "value": "", "type": "text", "description": "Optional — auto-generated if blank" },
                { "key": "weight", "value": "0.5", "type": "text", "description": "Optional, kg" },
                { "key": "images[]", "type": "file", "description": "Up to 5 images (jpeg/png/webp, max 2MB each). Add multiple rows named images[] for multiple files." }
              ]
            },
            "url": {
              "raw": "{{base_url}}/vendor/products",
              "host": ["{{base_url}}"],
              "path": ["vendor", "products"]
            },
            "description": "Create a new product. Use multipart/form-data. Add multiple images[] rows in Postman for multiple images (max 5). The response images[] array contains all uploaded images — use that for the gallery, and primary_image for the cover/thumbnail. Do NOT use the root image_url field (always null for vendor products)."
          },
          "response": []
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/vendor/products/1",
              "host": ["{{base_url}}"],
              "path": ["vendor", "products", "1"]
            },
            "description": "Get a specific product by ID (must belong to the authenticated vendor)."
          },
          "response": []
        },
        {
          "name": "Update Product (Add / Remove Images)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Updated Product Name", "type": "text" },
                { "key": "short_description", "value": "Updated short description", "type": "text" },
                { "key": "description", "value": "Updated full description", "type": "text" },
                { "key": "price", "value": "5500", "type": "text" },
                { "key": "quantity", "value": "8", "type": "text" },
                { "key": "category_id", "value": "1", "type": "text" },
                { "key": "status", "value": "active", "type": "text" },
                { "key": "remove_images[]", "value": "84", "type": "text", "description": "IDs of existing images to DELETE (from images[].id in the product response). Add multiple rows for multiple deletions." },
                { "key": "images[]", "type": "file", "description": "New image files to ADD. Existing images not in remove_images[] are kept. Max total 5 images." }
              ]
            },
            "url": {
              "raw": "{{base_url}}/vendor/products/1",
              "host": ["{{base_url}}"],
              "path": ["vendor", "products", "1"]
            },
            "description": "Update product details and manage images simultaneously. To remove images pass their IDs in remove_images[] (get IDs from the product's images[].id). To add new images pass files in images[]. Both can be done in the same request."
          },
          "response": []
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/vendor/products/1",
              "host": ["{{base_url}}"],
              "path": ["vendor", "products", "1"]
            },
            "description": "Delete a product and all its images (must belong to the authenticated vendor)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            }
          },
          "response": []
        },
        {
          "name": "Get Product by Slug",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/adjustable-dumbbells-set",
              "host": ["{{base_url}}"],
              "path": ["products", "adjustable-dumbbells-set"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
